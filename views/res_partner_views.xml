<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- res.partner -->
    <record model="ir.ui.view" id="is_view_partner_form">
        <field name="name">is_view_partner_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- v20 : vat dans div[@name='identifiers'], sans libellé -->
            <xpath expr="//div[@name='identifiers']" position="after">
                <field name="is_prefixe" invisible="not is_company"/>
                <field name="is_numero" invisible="not is_company" readonly="1"/>
                <field name="is_numero_fournisseur" invisible="not is_company" readonly="1"/>
                <field name="is_service"                   invisible="not is_company"/>
                <field name="is_contact"                   invisible="not is_company or not is_fournisseur"/>
                <field name="is_classement_id"             invisible="not is_company or not is_client"/>
                <field name="is_classement_principal_id"   invisible="not is_company or not is_fournisseur"/>
                <field name="is_classement_secondaire_id"  invisible="not is_company or not is_fournisseur"/>
                <field name="is_classement_tertiaire_id"   invisible="not is_company or not is_fournisseur"/>
                <field name="is_specialite_ids"            invisible="not is_company or not is_client"  widget="many2many_tags"/>
            </xpath>
            <field name="website" position="after">
                <field name="is_acces_pro_url"     invisible="not is_company or not is_fournisseur"  widget="url"/>
                <field name="is_acces_pro_login"   invisible="not is_company or not is_fournisseur"/>
                <field name="is_acces_pro_pwd"     invisible="not is_company or not is_fournisseur"/>
            </field>
            <!-- v20 : title (supprimé) et customer / supplier (supprimés en v13) recréés, aux mêmes places qu'en v12 -->
            <xpath expr="(//field[@name='function'])[1]" position="after">
                <field name="is_titre_id" options="{'no_open': True}" invisible="is_company"/>
            </xpath>
            <group name="sale" position="inside">
                <field name="is_client"/>
            </group>
            <group name="purchase" position="inside">
                <field name="is_fournisseur"/>
            </group>
        </field>
    </record>
    <record model="ir.ui.view" id="is_view_partner_tree">
        <field name="name">is_view_partner_tree</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="email" position="replace"/>
            <field name="city" position="replace"/>
            <field name="complete_name" position="before">
                <field name="is_classement_id"/>
                <field name="is_specialite_ids" widget="many2many_tags"/>
                <field name="is_prefixe"/>
            </field>
            <field name="phone" position="before">
                <field name="email"/>
                <field name="zip"/>
                <field name="city"/>
            </field>
        </field>
    </record>
    <record id="is_view_res_partner_filter" model="ir.ui.view">
        <field name="name">is_view_res_partner_filter</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">
            <field name="user_id" position="before">
                <field name="is_classement_id"/>
                <field name="is_specialite_ids"/>
                <field name="is_prefixe"/>
                <field name="is_service"/>
                <field name="is_classement_principal_id"/>
                <field name="is_classement_secondaire_id"/>
                <field name="is_classement_tertiaire_id"/>
            </field>
            <!-- v20 : filtres standard v12 Clients, Fournisseurs et Sociétés (supprimés), sur les champs recréés -->
            <filter name="inactive" position="before">
                <filter string="Sociétés"     name="type_company" domain="[('is_company', '=', True)]"/>
                <filter string="Clients"      name="customer"     domain="[('is_client', '=', True)]"/>
                <filter string="Fournisseurs" name="supplier"     domain="[('is_fournisseur', '=', True)]"/>
                <separator/>
            </filter>
        </field>
    </record>
    <record  id="is_adresses_action" model="ir.actions.act_window">
        <field name="name">Adresses</field>
        <field name="res_model">res.partner</field>
        <field name="limit">200</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="context">{"search_default_customer":1}</field>
    </record>




    <record id="is_res_partner_documentation_tree" model="ir.ui.view">
        <field name="name">is_res_partner_documentation_tree</field>
        <field name="model">res.partner</field>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_classement_principal_id"/>
                <field name="zip"/>
                <field name="city"/>
                <field name="phone"/>
                <field name="website"/>
            </list>
        </field>
    </record>
    <record  id="is_documentation_action" model="ir.actions.act_window">
        <field name="name">Documentation</field>
        <field name="res_model">res.partner</field>
        <field name="limit">200</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="view_id" ref="is_res_partner_documentation_tree"/>
        <field name="domain">[('is_fournisseur','=', True)]</field>
        <field name="context">{'search_default_type_company': 1,'default_is_client': 0,'default_is_fournisseur': 1, 'default_is_company': True}</field>
    </record>





    <!-- is.classement -->
    <record id="is_classement_form" model="ir.ui.view">
        <field name="name">is.classement.form</field>
        <field name="model">is.classement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
